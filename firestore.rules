rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasUserProfile() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function isActiveUser() {
      return hasUserProfile()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.active == true;
    }

    function isAdmin() {
      return isActiveUser()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "admin";
    }

    function isBranch() {
      return isActiveUser()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "branch";
    }

    function myBranchId() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.branchId;
    }

    match /users/{userId} {
      allow read: if signedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      allow create, update, delete: if isAdmin();
    }

    match /branches/{branchId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    match /barbers/{barberId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    // สถานะเข้างานประจำวัน ณ ปัจจุบัน (Realtime Presence)
    match /barber_presence/{barberId} {
      allow read: if isAdmin()
        || (
          isBranch()
          && resource.data.branchId == myBranchId()
        );

      allow create: if isBranch()
        && request.resource.data.branchId == myBranchId();

      allow update: if isBranch()
        && request.resource.data.branchId == myBranchId();

      allow create, update, delete: if isAdmin();
    }

    // ประวัติเข้างานรายวัน ใช้คำนวณประกันมือย้อนหลัง
    match /barber_attendance/{attendanceId} {
      // Transactions must be able to check whether a new attendance ID exists.
      // This grants no access to another branch's existing attendance.
      allow get: if isBranch()
        && !exists(/databases/$(database)/documents/barber_attendance/$(attendanceId));
      allow read: if isAdmin()
        || (
          isBranch()
          && resource.data.branchId == myBranchId()
        );

      allow create: if isBranch()
        && request.resource.data.branchId == myBranchId();

      allow update: if isBranch()
        && resource.data.branchId == myBranchId()
        && request.resource.data.branchId == myBranchId();

      allow create, update, delete: if isAdmin();
    }

    // Events must be created with their first successful source transaction.
    match /admin_notifications/{notificationId} {
      function validCheckIn() {
        let n = request.resource.data;
        let attendancePath = /databases/$(database)/documents/barber_attendance/$(n.attendanceId);
        let a = getAfter(attendancePath).data;
        return n.keys().hasAll(["id", "type", "barberId", "barberName", "branchId", "branchName", "attendanceId", "eventAt", "createdAt", "read", "message"])
          && n.keys().hasOnly(["id", "type", "barberId", "barberName", "branchId", "branchName", "attendanceId", "eventAt", "createdAt", "read", "message"])
          && n.type == "attendance_checkin"
          && n.id == notificationId
          && notificationId == "attendance-checkin_" + n.attendanceId
          && n.attendanceId == a.dateKey + "_" + n.branchId + "_" + n.barberId
          && !exists(attendancePath)
          && a.attended == true && a.active == true
          && a.checkInMethod in ["pin", "rfid"]
          && a.barberId == n.barberId && a.barberName == n.barberName
          && a.branchId == n.branchId && a.branchName == n.branchName
          && n.barberId is string && n.barberName is string
          && n.branchId is string && n.branchName is string
          && n.eventAt == a.checkInAt && n.eventAt == request.time
          && n.createdAt == request.time && n.read == false
          && n.message == n.barberName + " เข้างานแล้ว";
      }
      function validStoreClosing() {
        let n = request.resource.data;
        let closingPath = /databases/$(database)/documents/daily_closings/$(n.closingId);
        let c = getAfter(closingPath).data;
        return n.keys().hasAll(["id", "type", "barberId", "barberName", "branchId", "branchName", "closingId", "eventAt", "createdAt", "read", "message"])
          && n.keys().hasOnly(["id", "type", "barberId", "barberName", "branchId", "branchName", "closingId", "eventAt", "createdAt", "read", "message"])
          && n.type == "store_closed"
          && n.id == notificationId
          && notificationId == "store-closed_" + n.closingId
          && n.closingId == n.branchId + "_" + c.dateKey
          && !exists(closingPath)
          && c.id == n.closingId && c.cashClosingVersion == 1
          && c.closedByBarberId == n.barberId && c.closedByBarberName == n.barberName
          && c.branchId == n.branchId && c.branchName == n.branchName
          && n.barberId is string && n.barberName is string
          && n.branchId is string && n.branchName is string
          && n.eventAt == c.closedAt && n.eventAt == request.time
          && n.createdAt == request.time && n.read == false
          && n.message == n.barberName + " ปิดร้านแล้ว";
      }
      allow read: if isAdmin();
      allow create: if (isAdmin() || (isBranch() && request.resource.data.branchId == myBranchId()))
        && ((request.resource.data.type == "attendance_checkin" && validCheckIn())
          || (request.resource.data.type == "store_closed" && validStoreClosing()));
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"])
        && request.resource.data.read == true;
      allow delete: if false;
    }

    // Push devices ของ Admin แต่ละเครื่อง ใช้ส่ง Web Push/FCM
    match /admin_push_devices/{deviceId} {
      allow get: if isAdmin()
        && resource.data.uid == request.auth.uid;

      allow create: if isAdmin()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.deviceId is string
        && request.resource.data.fid is string
        && request.resource.data.fid.size() > 0
        && request.resource.data.active == true
        && request.resource.data.updatedAt == request.time;

      allow update: if isAdmin()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.deviceId == resource.data.deviceId
        && request.resource.data.fid is string
        && request.resource.data.fid.size() > 0
        && request.resource.data.active == true
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin()
        && resource.data.uid == request.auth.uid;
    }

    match /daily_closings/{closingId} {
      // The closing transaction checks for an existing record before creating it.
      // A missing document has no branchId; permit only this absence check.
      allow get: if isBranch()
        && !exists(/databases/$(database)/documents/daily_closings/$(closingId));

      allow read: if isAdmin()
        || (
          isBranch()
          && resource.data.branchId == myBranchId()
        );

      allow create: if isBranch()
        && request.resource.data.branchId == myBranchId();

      allow update: if isBranch()
        && request.resource.data.branchId == myBranchId();

      allow create, update, delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow create: if isBranch()
        && request.resource.data.branchId == myBranchId();

      allow read: if isAdmin()
        || (
          isBranch()
          && resource.data.branchId == myBranchId()
        );

      // POS may only turn its own branch transaction into a voided record.
      // Original sale fields are immutable and the record is never hard-deleted.
      allow update: if isBranch()
        && resource.data.branchId == myBranchId()
        && request.resource.data.branchId == resource.data.branchId
        && (!("status" in resource.data) || resource.data.status != "voided")
        && !("voidedAt" in resource.data)
        && request.resource.data.status == "voided"
        && request.resource.data.voidedByUid == request.auth.uid
        && request.resource.data.voidReason is string
        && request.resource.data.voidReason.size() > 0
        && request.resource.data.voidedByBarberId is string
        && request.resource.data.voidedByBarberName is string
        && exists(/databases/$(database)/documents/barber_presence/$(request.resource.data.voidedByBarberId))
        && get(/databases/$(database)/documents/barber_presence/$(request.resource.data.voidedByBarberId)).data.active == true
        && get(/databases/$(database)/documents/barber_presence/$(request.resource.data.voidedByBarberId)).data.branchId == myBranchId()
        && request.resource.data.voidedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "voidReason",
          "voidedAt",
          "voidedByUid",
          "voidedByEmail",
          "voidedByBarberId",
          "voidedByBarberName"
        ]);

      allow delete: if false;
    }

    // ประวัติการจ่ายเงินช่าง: Admin สร้างและอ่านได้
    match /barber_payouts/{payoutId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ค่าใช้จ่ายร้าน / เบิกเงินสดไปซื้อของ: POS บันทึกได้ / Admin อ่านและจัดการได้
    match /shop_expenses/{expenseId} {
      allow read: if isAdmin()
        || (
          isBranch()
          && resource.data.branchId == myBranchId()
        );

      allow create: if (
          isBranch()
          && request.resource.data.branchId == myBranchId()
        ) || isAdmin();

      allow update, delete: if isAdmin();
    }

    // Admin จัดการเบิกล่วงหน้า / POS สร้างได้เฉพาะเบิกทิปของสาขาตัวเอง
    match /barber_advances/{advanceId} {
      allow read: if isAdmin()
        || (
          isBranch()
          && resource.data.branchId == myBranchId()
        );

      allow create: if (
          isBranch()
          && request.resource.data.branchId == myBranchId()
          && request.resource.data.type == "tip"
          && request.resource.data.source == "pos"
          && request.resource.data.status == "active"
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.barberId is string
          && request.resource.data.barberId.size() > 0
        ) || isAdmin();

      allow update, delete: if isAdmin();
    }

    match /reader_scans/{scanDocumentId} {
      allow read: if isAdmin()
        || (
          isBranch()
          && resource.data.branchId == myBranchId()
        );

      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // ESP32 อ่านผลของ scanId ตัวเองด้วย REST
    match /reader_results/{scanId} {
      allow get: if true;
      allow list: if false;

      allow create: if isBranch()
        && request.resource.data.branchId == myBranchId();

      allow update: if isBranch()
        && resource.data.branchId == myBranchId()
        && request.resource.data.branchId == myBranchId();

      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
