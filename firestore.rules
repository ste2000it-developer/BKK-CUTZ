rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasUserProfile() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function isActiveUser() {
      return hasUserProfile()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.active == true;
    }

    function isAdmin() {
      return isActiveUser()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "admin";
    }

    function isBranch() {
      return isActiveUser()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "branch";
    }

    function myBranchId() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.branchId;
    }

    match /users/{userId} {
      allow read: if signedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      allow create, update, delete: if isAdmin();
    }

    match /branches/{branchId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    match /barbers/{barberId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    match /barber_presence/{barberId} {
      allow read: if isAdmin()
        || (
          isBranch()
          && resource.data.branchId == myBranchId()
        );

      allow create: if isBranch()
        && request.resource.data.branchId == myBranchId();

      allow update: if isBranch()
        && request.resource.data.branchId == myBranchId();

      allow create, update, delete: if isAdmin();
    }

    // ประวัติเข้างานรายวัน ใช้คำนวณประกันมือย้อนหลัง
    match /barber_attendance/{attendanceId} {
      allow read: if isAdmin()
        || (
          isBranch()
          && resource.data.branchId == myBranchId()
        );

      allow create: if isBranch()
        && request.resource.data.branchId == myBranchId();

      allow update: if isBranch()
        && resource.data.branchId == myBranchId()
        && request.resource.data.branchId == myBranchId();

      allow create, update, delete: if isAdmin();
    }

    match /daily_closings/{closingId} {
      allow read: if isAdmin()
        || (
          isBranch()
          && resource.data.branchId == myBranchId()
        );

      allow create: if isBranch()
        && request.resource.data.branchId == myBranchId();

      allow update: if isBranch()
        && request.resource.data.branchId == myBranchId();

      allow create, update, delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow create: if isBranch()
        && request.resource.data.branchId == myBranchId();

      allow read: if isAdmin()
        || (
          isBranch()
          && resource.data.branchId == myBranchId()
        );

      allow update, delete: if false;
    }

    // ประวัติการจ่ายเงินช่าง: Admin สร้างและอ่านได้
    // ใช้ document id แบบ payoutDate_barberId เพื่อกันจ่ายซ้ำรอบเดิม
    match /barber_payouts/{payoutId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /reader_scans/{scanDocumentId} {
      allow read: if isAdmin()
        || (
          isBranch()
          && resource.data.branchId == myBranchId()
        );

      allow create, update: if true;
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
